{
  "name": "arcana-pack-back",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/db/snapshot-art && cp src/db/snapshot-art/* dist/db/snapshot-art/",
    "start": "node dist/index.js",
    "db:init": "tsx src/db/init.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "art:ffa": "tsx src/db/farFarAwayArt.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.22.5",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jpeg-js": "^0.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
